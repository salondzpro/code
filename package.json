{
  "name": "salondz",
  "private": true,
  "version": "0.1.0",
  "description": "SalonDZ — réservation et agenda pour salons de coiffure et barbers en Algérie",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @salondz/api dev",
    "dev:web": "pnpm --filter @salondz/web dev",
    "dev:mobile": "pnpm --filter @salondz/mobile start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "db:reset": "node --env-file=.env scripts/db-migrate.mjs --reset",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:status": "node --env-file=.env scripts/db-migrate.mjs --status",
    "db:backup": "node --env-file=.env scripts/db-backup.mjs",
    "demo:seed": "node --env-file=.env scripts/demo.mjs",
    "demo:cleanup": "node --env-file=.env scripts/demo.mjs --cleanup",
    "demo:visuals": "node --env-file=.env scripts/demo-visuals.mjs",
    "test:e2e:mobile": "pnpm --filter @salondz/mobile test:e2e",
    "check:realtime": "node --env-file=.env scripts/check-realtime.mjs",
    "check:contact": "node --env-file=.env scripts/check-contact-hidden.mjs",
    "check:webpush": "node --env-file=.env scripts/check-webpush.mjs",
    "check:for-other": "node --env-file=.env scripts/check-booking-for-other.mjs",
    "check:badge": "node --env-file=.env scripts/check-pending-badge.mjs",
    "check:control": "node --env-file=.env scripts/check-admin-control.mjs",
    "check:pro-reminder": "node --env-file=.env scripts/check-pro-reminder.mjs",
    "check:pro-deletion": "node --env-file=.env scripts/check-pro-deletion.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "pg": "^8.16.0"
  }
}
