<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Le système réserve lui-même la place de la barre d'état (heure, réseau, batterie) et de la
             barre de navigation du bas. C'est ce qui permet de s'adapter à TOUS les téléphones — encoche,
             barre gestuelle ou trois boutons — sans mesurer quoi que ce soit dans l'application. Sans
             cela, les boutons du bas et le haut des écrans passaient sous les barres du téléphone. -->
        <item name="android:fitsSystemWindows">true</item>
        <!-- Barres opaques et claires, cohérentes avec le fond de l'application. -->
        <item name="android:statusBarColor">@color/salondzSurface</item>
        <item name="android:navigationBarColor">@color/salondzSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>