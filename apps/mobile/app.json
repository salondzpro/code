{
  "expo": {
    "name": "Salon DZ",
    "slug": "salondz",
    "version": "0.1.0",
    "scheme": "salondz",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "dz.salondz.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SalonDZ a besoin d'accéder à vos photos pour illustrer votre salon.",
        "NSCameraUsageDescription": "SalonDZ utilise l'appareil photo pour ajouter des photos de votre salon."
      }
    },
    "android": {
      "package": "dz.salondz.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7C3AED",
          "defaultChannel": "bookings"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SalonDZ a besoin d'accéder à vos photos pour illustrer votre salon.",
          "cameraPermission": "SalonDZ utilise l'appareil photo pour ajouter des photos de votre salon."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SalonDZ utilise votre position pour trouver les salons autour de vous."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77c24a0c-3bd9-43f5-8cbb-c1ad0ab08569"
      }
    },
    "owner": "salondz"
  }
}
