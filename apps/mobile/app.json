{
  "expo": {
    "name": "Salon DZ",
    "slug": "salondz",
    "version": "1.0.0",
    "scheme": "salondz",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "dz.salondz.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "SalonDZ a besoin d'accéder à vos photos pour illustrer votre salon.",
        "NSCameraUsageDescription": "SalonDZ utilise l'appareil photo pour ajouter des photos de votre salon."
      }
    },
    "android": {
      "package": "dz.salondz.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111214"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Salon DZ enregistre votre affiche QR dans votre galerie.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#111214",
          "defaultChannel": "bookings"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SalonDZ a besoin d'accéder à vos photos pour illustrer votre salon.",
          "cameraPermission": "SalonDZ utilise l'appareil photo pour ajouter des photos de votre salon.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SalonDZ utilise votre position pour trouver les salons autour de vous."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.** { *; }\n-dontwarn kotlin.reflect.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77c24a0c-3bd9-43f5-8cbb-c1ad0ab08569"
      }
    },
    "owner": "salondz"
  }
}
