# deps / builds
node_modules/
dist/
build/
.turbo/
*.tsbuildinfo

# env — jamais de secrets dans git
.env
.env.*
!.env.example

# expo / mobile
.expo/
.expo-shared/
apps/mobile/ios/
apps/mobile/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Clé de compte de service Firebase = secret d'envoi FCM, jamais dans git.
# apps/mobile/google-services.json, lui, est versionné : il est embarqué dans l'APK et public par conception.
*firebase-adminsdk*.json
fcm-service-account.json

# captures du test e2e navigateur
apps/web/test/shots/

# misc
.DS_Store
Thumbs.db
*.log
coverage/
.vscode/*
!.vscode/extensions.json
.idea/

# captures des écrans du design (régénérables : node design/split.mjs)
design/screens/*.png

# captures du test e2e mobile (Expo web)
apps/mobile/test/shots/

# comptes de démonstration (sessions) — pnpm demo:seed / demo:cleanup
scripts/.demo.json
# Sauvegardes locales de la base (pnpm db:backup)
backups/

# Clés et fichiers de publication (Play Console, App Store Connect, APNs) : jamais dans git.
secrets/

# Artefacts de build téléchargés localement pour import manuel Play Console : volumineux, régénérables,
# et gonflent l'archive envoyée à EAS Build s'ils traînent dans apps/mobile.
*.aab
*.apk

# Coque native Capacitor (apps/web/android) : le projet est versionné (manifeste, icônes, signature),
# mais pas ce que Gradle régénère ni les chemins propres à une machine.
apps/web/android/build/
apps/web/android/app/build/
apps/web/android/.gradle/
apps/web/android/local.properties
apps/web/android/capacitor-cordova-android-plugins/
apps/web/android/app/src/main/assets/public/
apps/web/android/app/src/main/assets/capacitor.config.json
apps/web/android/app/src/main/assets/capacitor.plugins.json

# Identifiants de signature locaux (mot de passe du .p12) : jamais dans git.
apps/mobile/credentials.json
