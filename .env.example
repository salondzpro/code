# ---- Supabase (projet: thpwvmtqzhtqlosgvced) ----
SUPABASE_URL=https://thpwvmtqzhtqlosgvced.supabase.co
# Clé publique (front web + mobile + API pour vérifier les JWT)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète — API SEULEMENT, jamais dans le front
SUPABASE_SECRET_KEY=sb_secret_xxx
# Secret JWT legacy (HS256) — secours si le JWKS ES256 est indisponible
SUPABASE_JWT_SECRET=
# Connexion Postgres directe (migrations uniquement)
DATABASE_URL=postgresql://postgres.thpwvmtqzhtqlosgvced:URL_ENCODED_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---- API Fastify ----
PORT=8090
HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:8090
CORS_ORIGINS=http://localhost:9000,http://localhost:8082
# Jeton partagé pour les endpoints /internal/* (cron pg_net -> API)
INTERNAL_CRON_TOKEN=change-me
SENTRY_DSN=
LOG_LEVEL=info
# Comptes de démonstration à accès direct (POST /v1/auth/dev-login, numéros + code 1111).
# Activé par défaut ; mettre 0 pour désactiver (recommandé en production réelle).
TEST_LOGIN_ENABLED=1

# ---- Web (Vite expose uniquement VITE_*) ----
VITE_SUPABASE_URL=https://thpwvmtqzhtqlosgvced.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_API_URL=http://localhost:8090
VITE_SENTRY_DSN=

# ---- Mobile (Expo expose uniquement EXPO_PUBLIC_*) ----
EXPO_PUBLIC_SUPABASE_URL=https://thpwvmtqzhtqlosgvced.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
EXPO_PUBLIC_API_URL=http://localhost:8090
EXPO_PUBLIC_SENTRY_DSN=
# Jeton d'accès Expo (https://expo.dev/settings/access-tokens) pour `eas init` / `eas build` sans connexion interactive.
# Ne jamais le coller dans un chat ni le versionner : uniquement dans .env (ignoré par git).
EXPO_TOKEN=
