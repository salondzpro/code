# ---- Supabase (projet: thpwvmtqzhtqlosgvced) ----
SUPABASE_URL=https://thpwvmtqzhtqlosgvced.supabase.co
# Clé publique (front web + mobile + API pour vérifier les JWT)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète — API SEULEMENT, jamais dans le front
SUPABASE_SECRET_KEY=sb_secret_xxx
# Secret JWT legacy (HS256) — secours si le JWKS ES256 est indisponible
SUPABASE_JWT_SECRET=
# Connexion Postgres directe (migrations uniquement)
DATABASE_URL=postgresql://postgres.thpwvmtqzhtqlosgvced:URL_ENCODED_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---- API Fastify ----
PORT=8787
HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Jeton partagé pour les endpoints /internal/* (cron pg_net -> API)
INTERNAL_CRON_TOKEN=change-me
SENTRY_DSN=
LOG_LEVEL=info

# ---- Web (Vite expose uniquement VITE_*) ----
VITE_SUPABASE_URL=https://thpwvmtqzhtqlosgvced.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_API_URL=http://localhost:8787
VITE_SENTRY_DSN=

# ---- Mobile (Expo expose uniquement EXPO_PUBLIC_*) ----
EXPO_PUBLIC_SUPABASE_URL=https://thpwvmtqzhtqlosgvced.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_SENTRY_DSN=
